# Sanity CMS — SAME project as the main asesmanila2026-website repo.
# Copy the values from that repo's .env.local (or sanity.io/manage).
# Leave unset to run entirely from local fallback content (content/bwaContent.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional override for the canonical site URL used in metadata/JSON-LD.
# Defaults to https://buildwithases.asesmanila.com (lib/site.ts).
# NEXT_PUBLIC_SITE_URL=
